# =============================================================================
# .env.example - configuration template for the Kafka-to-Snowflake pipeline
#
# Copy this file to ".env" (git-ignored) and adjust the values.
# Every key is optional except SNOWFLAKE_CONNECTION_NAME. A real environment
# variable with the same name overrides the value in .env.
# This file must never contain a password, key or token.
# =============================================================================

# --- Kafka -------------------------------------------------------------------
# Address of the local broker (host:port).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Topic the producer writes to and the consumer reads from.
KAFKA_TOPIC=order_events
# Dead-letter topic for messages the consumer cannot parse.
KAFKA_DLQ_TOPIC=order_events_dlq
# Consumer group; Kafka stores the committed offsets under this name.
KAFKA_GROUP_ID=snowflake-loader

# --- Micro-batching ----------------------------------------------------------
# Flush to Snowflake after this many records (count) ...
BATCH_MAX_RECORDS=500
# ... or after this many seconds since the first buffered record.
BATCH_MAX_SECONDS=5
# Back-off between retries after a Snowflake error: first wait and maximum wait (seconds).
RETRY_INITIAL_SECONDS=1
RETRY_MAX_SECONDS=60
# Most new columns one COPY may add (Snowflake limit, measured: 100). A batch
# introducing more new fields is split into several COPY operations.
MAX_NEW_COLUMNS_PER_COPY=100
# Folder for temporary batch files. Default: %LOCALAPPDATA%\kafka_snowflake_batches
# BATCH_DIR=C:\temp\kafka_snowflake_batches

# --- Snowflake ---------------------------------------------------------------
# REQUIRED. Name of the connection in your Snowflake config.toml
# (the same name you pass to "snow sql -c <connection>").
SNOWFLAKE_CONNECTION_NAME=
# Role that owns the schema and target table.
SNOWFLAKE_ROLE=CLAUDE_AI_ROLE
# Warehouse that runs COPY INTO (created by sql/00_admin_setup.sql).
SNOWFLAKE_WAREHOUSE=KAFKA_STREAMING_WH
# Location and names of the pipeline objects (created by sql/01_create_objects.sql).
SNOWFLAKE_DATABASE=AI_OPERATOR_DB
SNOWFLAKE_SCHEMA=KAFKA_STREAMING
SNOWFLAKE_TABLE=ORDER_EVENTS
SNOWFLAKE_STAGE=ORDER_EVENTS_STAGE
SNOWFLAKE_FILE_FORMAT=NDJSON_FF

# --- PostgreSQL source database (used only by the source_db package) ----------
# Where the PostgreSQL server listens.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Login name.
POSTGRES_USER=postgres
# REQUIRED for the source_db scripts. Put the real password in your .env only;
# leave it empty here. This file is committed, .env is not.
POSTGRES_PASSWORD=
# Database created for this project by "python -m source_db.setup_database".
POSTGRES_DATABASE=kafka_source_db
# Existing database to connect to when issuing CREATE DATABASE; it is not changed.
POSTGRES_MAINTENANCE_DATABASE=postgres

# --- Change data capture (used only by the cdc package and its scripts) --------
# Dedicated PostgreSQL login for Debezium, created by sql/postgres/02_cdc_setup.sql.
POSTGRES_CDC_USER=cdc_user
# REQUIRED before running the CDC setup and Kafka Connect. Choose a password,
# put it in your .env only, and leave it empty here.
POSTGRES_CDC_PASSWORD=
# Prefix of Debezium's topic names; the change events of the source table go to
# <prefix>.public.order_events.
CDC_TOPIC_PREFIX=pgcdc
# Consumer group of the CDC bridge.
CDC_BRIDGE_GROUP_ID=cdc-bridge
# The bridge flushes and commits after this many forwarded events (count).
CDC_BRIDGE_COMMIT_EVERY=100
# Kafka Connect REST interface (local only), used to read the connector status.
CONNECT_REST_URL=http://localhost:8083
