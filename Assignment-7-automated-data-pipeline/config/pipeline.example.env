# Assignment 7 - pipeline configuration template (placeholders only).
# Copy to config/pipeline.env (git-ignored) and fill in your own values.
# NO secrets belong here: AWS auth uses the local CLI profile and
# Snowflake auth uses the local Snowflake CLI connection.

# ---------- AWS ----------
AWS_PROFILE=default
AWS_ACCOUNT_ID=<AWS_ACCOUNT_ID>
AWS_REGION=ap-south-1
STACK_NAME=a7-orders-pipeline
S3_BUCKET=a7-orders-pipeline-<AWS_ACCOUNT_ID>
S3_LANDING_PREFIX=landing/orders/
LAMBDA_FUNCTION_NAME=a7-orders-generator
SCHEDULE_NAME=a7-orders-hourly
SNS_TOPIC_NAME=a7-orders-s3-events
SNOWFLAKE_S3_ROLE_NAME=a7-snowflake-s3-access-role

# ---------- Snowflake ----------
SNOWFLAKE_ACCOUNT=<your-snowflake-account>
SNOWFLAKE_CONNECTION=<SNOW_CLI_CONNECTION_NAME>
SNOWFLAKE_DEVELOPER_USER=<DEVELOPER_USER>
SNOWFLAKE_ROLE=A7_PIPELINE_ROLE
SNOWFLAKE_WAREHOUSE=A7_PIPELINE_WH
SNOWFLAKE_DATABASE=A7_ORDERS_DB
SNOWFLAKE_STORAGE_INTEGRATION=A7_S3_INT
SNOWFLAKE_EMAIL_INTEGRATION=A7_EMAIL_INT
SNOWFLAKE_PIPE=A7_ORDERS_DB.RAW.PIPE_ORDERS_INGEST

# ---------- EOD report ----------
EOD_EMAIL_RECIPIENT=YOUR_EMAIL@example.com
EOD_TIMEZONE=Asia/Kolkata
EOD_CRON=55 23 * * *
DT_TARGET_LAG=6 hours

# ---------- Generator ----------
ROWS_PER_FILE_MIN=80
ROWS_PER_FILE_MAX=150
DEFECT_RATE=0.08
