{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadLandingObjectsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::a7-orders-pipeline-<AWS_ACCOUNT_ID>/landing/orders/*"
    },
    {
      "Sid": "ListLandingPrefixOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::a7-orders-pipeline-<AWS_ACCOUNT_ID>",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "landing/orders/",
            "landing/orders/*"
          ]
        }
      }
    },
    {
      "Sid": "BucketLocationForSnowflake",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::a7-orders-pipeline-<AWS_ACCOUNT_ID>"
    }
  ]
}
